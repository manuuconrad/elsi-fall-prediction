        "plt.figure(figsize=(10, 6))\n",
        "colors = ['#d9534f' if x > 1.2 else '#5bc0de' for x in df_plot['Odds Ratio']]\n",
        "\n",
        "ax = sns.barplot(x='Odds Ratio', y='Variável', data=df_plot, palette=colors)\n",
